# Copy to terraform.tfvars and set your own public IP (kept out of git).
my_ip_cidr = "203.0.113.25/32"

# digest of the image the pipeline built and scanned (see the build job log)
image         = "registry.gitlab.com/souhabenelaam/devsecops-platform@sha256:<digest>"
registry_user = "<deploy token username>"
# registry_token goes in the env var TF_VAR_registry_token, not here
